{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run server",
        "type": "dotnet",
        "request": "launch",
        "projectPath": "${workspaceFolder}/server/server.csproj"
      },
      {
        "name": "Run client",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/client/node_modules/@angular/cli/bin/ng",
        "args": ["serve"],
        "cwd": "${workspaceFolder}/client",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      },
      {
        "name": "Publish",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/server.js",
        "preLaunchTask": "build-and-publish",
        "outFiles": [
          "${workspaceFolder}/out/**/*.js"
        ]
      },
      {
        "name": "Docker build and run",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/server.js",
        "preLaunchTask": "docker-run",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      },
      {
        "name": "Docker build github",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/server.js",
        "preLaunchTask": "docker-ghcr-push",
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen"
      }
    ],
    "compounds": [
      {
        "name": "Run server and client",
        "configurations": [
          "Run server",
          "Run client"
        ]
      }
    ]
  }